# 1. Môi trường phát triển Local (Mặc định):
VITE_API_V1_URL=http://localhost:8080/api/v1
VITE_WS_URL=http://localhost:8080/ws

# 2. Môi trường Triển khai Production (Khi deploy lên Vercel / VPS / Docker):
# VITE_API_V1_URL=https://api.yourdomain.com/api/v1
# VITE_WS_URL=https://api.yourdomain.com/ws
