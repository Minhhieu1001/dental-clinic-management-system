{
  "expo": {
    "name": "Crown Dental",
    "slug": "mobile",
    "owner": "crowndental-kltn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crowndental.patient"
    },
    "android": {
      "package": "com.crowndental.patient",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Crown Dental sử dụng máy ảnh để quét mã QR check-in và chụp ảnh đại diện."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Crown Dental truy cập thư viện ảnh để gửi ảnh tư vấn và cập nhật ảnh đại diện.",
          "cameraPermission": "Cho phép Crown Dental sử dụng máy ảnh để chụp ảnh."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e46f2378-2d60-4e33-9099-da31b33cea49"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e46f2378-2d60-4e33-9099-da31b33cea49"
      }
    }
  }
}
